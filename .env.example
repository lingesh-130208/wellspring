# Server-only Gemini API key. Never use VITE_ prefix for secrets.
GEMINI_API_KEY=

# Optional Supabase project URL and server-only service key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Strong random token for clinic-only publish/list endpoints.
CLINIC_ADMIN_TOKEN=

# Apply supabase/schema.sql in the Supabase SQL editor.
# Use synthetic/de-identified data only in this hackathon prototype.
